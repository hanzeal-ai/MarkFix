FROM node:24-bookworm-slim
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --filter @markfix/api... --frozen-lockfile
RUN pnpm --filter @markfix/database db:generate && pnpm --filter @markfix/api build
EXPOSE 4310
STOPSIGNAL SIGTERM
CMD ["pnpm", "--filter", "@markfix/api", "start"]
