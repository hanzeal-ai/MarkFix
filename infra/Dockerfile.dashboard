FROM node:24-alpine AS workspace
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
  npm_config_trust_lockfile=true
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --filter @markfix/dashboard... --frozen-lockfile --trust-lockfile
COPY tsconfig.json tsconfig.json
COPY apps/dashboard apps/dashboard
COPY apps/desktop/package.json apps/desktop/package.json
COPY packages/api-client packages/api-client
COPY packages/contracts packages/contracts
COPY packages/ui packages/ui


FROM workspace AS development
WORKDIR /app/apps/dashboard
EXPOSE 4311
CMD ["./node_modules/.bin/vite", "--host", "0.0.0.0", "--port", "4311"]

FROM workspace AS build
# The desktop manifest is copied only for its version; do not materialize the desktop workspace.
RUN cd apps/dashboard && ../../node_modules/.bin/tsc -b && ./node_modules/.bin/vite build

FROM nginx:1.29-alpine
COPY --from=build /app/apps/dashboard/dist /usr/share/nginx/html
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
