generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  READY_FOR_VERIFY
  RESOLVED
  CLOSED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubmissionStatus {
  PENDING
  UPLOADING
  READY
  FINALIZED
  EXPIRED
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @db.Uuid
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  baseUrl     String?
  reports     Report[]
  submissions ReportSubmission[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ReportSubmission {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @db.Uuid
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  payload        Json
  status         SubmissionStatus @default(PENDING)
  expiresAt      DateTime
  artifact       Artifact?
  report         Report?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([projectId, idempotencyKey])
}

model Report {
  id             String            @id @default(uuid()) @db.Uuid
  projectId      String            @db.Uuid
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissionId   String            @unique @db.Uuid
  submission     ReportSubmission  @relation(fields: [submissionId], references: [id])
  title          String
  description    String
  status         ReportStatus      @default(OPEN)
  priority       ReportPriority    @default(MEDIUM)
  version        Int               @default(1)
  captureBundle  Json
  screenshotPath String
  comments       Comment[]
  activities     Activity[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Artifact {
  id           String            @id @default(uuid()) @db.Uuid
  submissionId String            @unique @db.Uuid
  submission   ReportSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mimeType     String
  size         Int
  sha256       String
  objectKey    String            @unique
  uploadStatus String            @default("PENDING")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  reportId   String   @db.Uuid
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @db.Uuid
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  createdAt DateTime @default(now())
}
