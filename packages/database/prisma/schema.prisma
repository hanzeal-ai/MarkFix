generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  READY_FOR_VERIFY
  RESOLVED
  CLOSED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubmissionStatus {
  PENDING
  UPLOADING
  READY
  FINALIZED
  EXPIRED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  REPORTER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique
  displayName         String
  passwordHash        String?
  emailVerifiedAt     DateTime?
  memberships         Membership[]
  createdWorkspaces   Workspace[]              @relation("WorkspaceCreator")
  assignedReports     Report[]                 @relation("ReportAssignee")
  reportedReports     Report[]                 @relation("ReportReporter")
  comments            Comment[]
  activities          Activity[]
  reportSubmissions   ReportSubmission[]
  authSessions        AuthSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceName       String
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}

model Workspace {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdById String?      @db.Uuid
  createdBy   User?        @relation("WorkspaceCreator", fields: [createdById], references: [id])
  projects    Project[]
  memberships Membership[]
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  workspaceId String           @db.Uuid
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@id([workspaceId, userId])
}

model Invitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Project {
  id           String             @id @default(uuid()) @db.Uuid
  workspaceId  String             @db.Uuid
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  baseUrl      String?
  environments Environment[]
  reports      Report[]
  submissions  ReportSubmission[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Environment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  baseUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId, createdAt])
}

model ReportSubmission {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @db.Uuid
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById    String?          @db.Uuid
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  idempotencyKey String
  requestHash    String
  payload        Json
  status         SubmissionStatus @default(PENDING)
  expiresAt      DateTime
  artifact       Artifact?
  report         Report?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([projectId, idempotencyKey])
}

model Report {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @db.Uuid
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissionId   String           @unique @db.Uuid
  submission     ReportSubmission @relation(fields: [submissionId], references: [id])
  title          String
  description    String
  status         ReportStatus     @default(OPEN)
  priority       ReportPriority   @default(MEDIUM)
  version        Int              @default(1)
  captureBundle  Json
  screenshotPath String
  assigneeId     String?          @db.Uuid
  assignee       User?            @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId     String?          @db.Uuid
  reporter       User?            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  comments       Comment[]
  activities     Activity[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Artifact {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @unique @db.Uuid
  submission   ReportSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mimeType     String
  size         Int
  sha256       String
  objectKey    String           @unique
  uploadStatus String           @default("PENDING")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  reportId   String   @db.Uuid
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorName String
  authorId   String?  @db.Uuid
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @db.Uuid
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
