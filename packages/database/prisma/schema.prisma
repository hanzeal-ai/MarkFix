generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  FIX_FAILED
  OPEN
  IN_PROGRESS
  READY_FOR_VERIFY
  RESOLVED
  CLOSED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubmissionStatus {
  PENDING
  UPLOADING
  READY
  FINALIZED
  EXPIRED
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  REPORTER
}

enum AccountPlan {
  FREE
  TEAM
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum ProjectRecordKind {
  CAPTURE
  ELEMENT_COMMENT
  DIAGNOSTIC
}

model User {
  id                   String                   @id @default(uuid()) @db.Uuid
  email                String                   @unique
  displayName          String
  passwordHash         String?
  emailVerifiedAt      DateTime?
  memberships          Membership[]
  ownedProjects        Project[]                @relation("ProjectOwner")
  plan                 AccountPlan              @default(FREE)
  upgradeRequestedAt   DateTime?
  assignedReports      Report[]                 @relation("ReportAssignee")
  reportedReports      Report[]                 @relation("ReportReporter")
  comments             Comment[]
  activities           Activity[]
  reportSubmissions    ReportSubmission[]
  annotationReadGrants AnnotationReadGrant[]
  agentGrants          AgentGrant[]
  agentRepositories    AgentRepository[]
  authSessions         AuthSession[]
  verificationTokens   EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceName       String
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}

model Membership {
  projectId String           @db.Uuid
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@id([projectId, userId])
}

model Invitation {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String      @db.Uuid
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email      String
  role       ProjectRole
  tokenHash  String      @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Project {
  id                   String                    @id @default(uuid()) @db.Uuid
  ownerId              String                    @db.Uuid
  owner                User                      @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships          Membership[]
  invitations          Invitation[]
  name                 String
  baseUrl              String?
  category             String                    @default("网站体验")
  environments         Environment[]
  reports              Report[]
  submissions          ReportSubmission[]
  repositoryId         String?                   @db.Uuid
  repository           AgentRepository?          @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  repositoryName       String?
  desktopState         ProjectDesktopState?
  draftRecords         ProjectAnnotationRecord[]
  annotationBatches    ProjectAnnotationBatch[]
  annotationReadGrants AnnotationReadGrant[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([ownerId, updatedAt])
}

model ProjectDesktopState {
  projectId String   @id @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payload   Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
}

model ProjectAnnotationRecord {
  id          String            @id @db.Uuid
  projectId   String            @db.Uuid
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        ProjectRecordKind
  pageUrl     String
  status      String
  payload     Json
  renderedPng Bytes?
  sourcePng   Bytes?
  ready       Boolean           @default(false)
  createdAt   DateTime
  updatedAt   DateTime

  @@index([projectId, kind, ready, updatedAt])
  @@index([projectId, pageUrl, updatedAt])
}

model ProjectAnnotationBatch {
  id          String   @id @db.Uuid
  projectId   String   @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payload     Json
  submittedAt DateTime

  @@index([projectId, submittedAt])
}

model Environment {
  id          String             @id @default(uuid()) @db.Uuid
  projectId   String             @db.Uuid
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  baseUrl     String
  submissions ReportSubmission[]
  reports     Report[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([projectId, name])
  @@index([projectId, createdAt])
}

model ReportSubmission {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @db.Uuid
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId  String?          @db.Uuid
  environment    Environment?     @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  createdById    String?          @db.Uuid
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  idempotencyKey String
  requestHash    String
  payload        Json
  status         SubmissionStatus @default(PENDING)
  expiresAt      DateTime
  artifact       Artifact?
  report         Report?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([projectId, idempotencyKey])
  @@index([status, expiresAt])
}

model Report {
  id              String            @id @default(uuid()) @db.Uuid
  projectId       String            @db.Uuid
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId   String?           @db.Uuid
  environment     Environment?      @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  submissionId    String            @unique @db.Uuid
  submission      ReportSubmission  @relation(fields: [submissionId], references: [id])
  title           String
  description     String
  status          ReportStatus      @default(OPEN)
  rejectionReason String?
  priority        ReportPriority    @default(MEDIUM)
  version         Int               @default(1)
  captureBundle   Json
  screenshotPath  String?
  assigneeId      String?           @db.Uuid
  assignee        User?             @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId      String?           @db.Uuid
  reporter        User?             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  fixAttempts     AgentFixAttempt[]
  comments        Comment[]
  activities      Activity[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([projectId, updatedAt])
  @@index([projectId, createdAt, id])
}

model Artifact {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @unique @db.Uuid
  submission   ReportSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mimeType     String
  size         Int
  sha256       String
  objectKey    String           @unique
  uploadStatus String           @default("PENDING")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  reportId   String   @db.Uuid
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorName String
  authorId   String?  @db.Uuid
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @db.Uuid
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model AgentDeviceRequest {
  id             String      @id @default(uuid()) @db.Uuid
  deviceCodeHash String      @unique
  userCode       String      @unique
  deviceName     String
  agentType      String      @default("codex")
  status         String      @default("PENDING")
  grantId        String?     @unique @db.Uuid
  grant          AgentGrant? @relation(fields: [grantId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime    @default(now())
}

model AgentGrant {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName      String
  agentType       String              @default("codex")
  projectIds      String[]            @db.Uuid
  accessHash      String?             @unique
  refreshHash     String?             @unique
  accessExpiresAt DateTime?
  expiresAt       DateTime
  revokedAt       DateTime?
  lastUsedAt      DateTime            @default(now())
  createdAt       DateTime            @default(now())
  deviceRequest   AgentDeviceRequest?
  fixAttempts     AgentFixAttempt[]

  @@index([userId])
}

model AgentRepository {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  localId    String    @db.Uuid
  name       String
  deviceName String
  agentType  String    @default("codex")
  projects   Project[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, localId])
  @@index([userId, name])
}

model AgentFixAttempt {
  id             String     @id @db.Uuid
  reportId       String     @db.Uuid
  report         Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  grantId        String     @db.Uuid
  grant          AgentGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  status         String     @default("RUNNING")
  reportVersion  Int
  leaseExpiresAt DateTime
  summary        String?
  reason         String?
  stage          String?
  evidence       Json?
  resultHash     String?
  createdAt      DateTime   @default(now())
  finishedAt     DateTime?

  @@index([reportId, createdAt])
}

model AnnotationReadGrant {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, projectId])
}
